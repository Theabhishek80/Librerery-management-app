# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

MYSQL_ROOT_PASSWORD=change_me_to_a_strong_password
APP_JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars_long_for_hs512
APP_ADMIN_PASSWORD=change_me_admin_password
APP_CORS_ALLOWED_ORIGINS=http://localhost
